# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEFAULT_MODEL=qwen2.5

# Groq API 키 (필수 — https://console.groq.com 에서 무료 발급)
GROQ_API_KEY=

# Game API 설정 (선택 사항 — 없으면 해당 기능만 비활성화)
STEAM_API_KEY=
RIOT_API_KEY=

# Pinecone 설정 (선택 사항 — 없으면 in-memory 검색 사용)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=vllm-search

# CORS 추가 허용 도메인 (쉼표 구분, 선택 사항)
CORS_ORIGINS=
