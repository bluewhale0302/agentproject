{
  "version": 2,
  "builds": [
    {
      "src": "webapp/frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "webapp/backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/webapp/backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/webapp/frontend/$1"
    }
  ],
  "env": {
    "DEFAULT_MODEL": "qwen2.5"
  }
}
